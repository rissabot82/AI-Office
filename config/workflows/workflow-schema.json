{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai-office/schemas/workflow-schema.json",
  "title": "AI Office Workflow",
  "type": "object",
  "required": [
    "workflow_id",
    "title",
    "description",
    "status",
    "owner_agent",
    "lead_department",
    "created_at",
    "updated_at",
    "tasks",
    "history"
  ],
  "properties": {
    "workflow_id": {
      "type": "string",
      "pattern": "^WORKFLOW-[0-9]{8}-[0-9]{4}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "planning",
        "ready",
        "active",
        "blocked",
        "review",
        "approved",
        "completed",
        "cancelled",
        "failed",
        "archived"
      ]
    },
    "owner_agent": {
      "type": "string"
    },
    "lead_department": {
      "type": "string"
    },
    "template": {
      "type": "string"
    },
    "created_by": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "due_date": {
      "type": [
        "string",
        "null"
      ]
    },
    "approval_required": {
      "type": "boolean"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "not-required"
      ]
    },
    "progress": {
      "type": "object",
      "required": [
        "total_tasks",
        "completed_tasks",
        "blocked_tasks",
        "percentage"
      ],
      "properties": {
        "total_tasks": {
          "type": "integer",
          "minimum": 0
        },
        "completed_tasks": {
          "type": "integer",
          "minimum": 0
        },
        "blocked_tasks": {
          "type": "integer",
          "minimum": 0
        },
        "percentage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "task_id",
          "title",
          "assigned_agent",
          "required",
          "dependencies"
        ],
        "properties": {
          "task_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "assigned_agent": {
            "type": "string"
          },
          "lead_department": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "sequence": {
            "type": "integer"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string"
          }
        }
      }
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
