{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai-office/schemas/openclaw-artifact-manifest-schema.json",
  "title": "AI Office OpenClaw Artifact Manifest",
  "type": "object",
  "required": [
    "artifact_manifest_id",
    "execution_id",
    "bridge_request_id",
    "created_at",
    "artifact_count",
    "artifacts"
  ],
  "properties": {
    "artifact_manifest_id": {
      "type": "string"
    },
    "execution_id": {
      "type": "string"
    },
    "bridge_request_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "artifact_count": {
      "type": "integer"
    },
    "artifacts": {
      "type": "array"
    }
  }
}
