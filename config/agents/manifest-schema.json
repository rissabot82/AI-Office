{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Office Agent Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "status",
    "department",
    "purpose",
    "capabilities",
    "approval_required",
    "knowledge_paths",
    "workspace_paths"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "paused",
        "deprecated",
        "archived"
      ]
    },
    "department": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "approval_required": {
      "type": "boolean"
    },
    "knowledge_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "workspace_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
