{
  "schema_version": "1.0.0",
  "version": "2.6.0",
  "part": "A",
  "release_name": "Memory & Context Integration",
  "mode": "architecture_only",
  "enabled": false,
  "memory_types": [
    "project",
    "dealership",
    "organization",
    "workflow",
    "user_approved"
  ],
  "retrieval": {
    "max_context_items": 12,
    "max_context_characters": 12000,
    "prefer_recent": true,
    "prefer_high_relevance": true,
    "allow_cross_project_context": false
  },
  "safety": {
    "require_explicit_user_approval_for_sensitive_memory": true,
    "do_not_store_secrets": true,
    "do_not_store_api_keys": true,
    "do_not_store_tokens": true,
    "allow_manual_delete": true,
    "allow_manual_disable": true
  },
  "persistence": {
    "root": "workspace/memory",
    "index": "workspace/memory/indexes/memory-index.json",
    "records": "workspace/memory/records",
    "context_snapshots": "workspace/memory/context-snapshots"
  }
}
