{
  "schema_version": "1.0.0",
  "version": "2.4.0",
  "part": "A",
  "release_name": "Discord Mobile Operations",
  "status": "architecture",
  "security": {
    "token_source": "environment",
    "token_environment_variable": "AI_OFFICE_DISCORD_BOT_TOKEN",
    "never_persist_token": true,
    "default_deny": true,
    "require_allowed_user": true,
    "require_allowed_guild": true,
    "require_allowed_channel": true
  },
  "intake": {
    "chief_of_staff_first": true,
    "create_conversation_if_missing": true,
    "persist_discord_session_mapping": true,
    "persist_inbound_events": true,
    "persist_outbound_events": true
  },
  "limits": {
    "max_message_characters": 8000,
    "max_discord_reply_characters": 1900
  },
  "commands": {
    "prefix": "/",
    "reserved": [
      "new",
      "session",
      "status",
      "help"
    ]
  }
}
